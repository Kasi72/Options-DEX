# Copy this file to .env and supply local credentials only for explicit live collection.
# Never commit populated credentials.
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
# Read-only dashboard connection (publishable/anon key only).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Collector-only secret; never expose this to Streamlit or commit it.
SUPABASE_SERVICE_ROLE_KEY=
